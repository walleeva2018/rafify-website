  box-shadow: 0 26px 70px rgba(0, 0, 0, 0.42);
}

.media-tile::before,
.strip-item::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(120deg, rgba(255, 255, 255, 0.14), transparent 34%),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 16px);
