  height: 3px;
  background: var(--secondary);
  transform: scaleX(0);
  transform-origin: 0 50%;
  z-index: 2000;
  box-shadow: 0 0 18px rgba(201, 198, 80, 0.5);
}

/* Navigation */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
