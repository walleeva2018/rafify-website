}

.stat-label {
  font-size: 0.875rem;
  font-weight: 500;
}

.hero .stat-label {
  color: rgba(255, 255, 255, 0.7);
}

.media-composition {
  position: relative;
  min-height: 560px;
  transform-style: preserve-3d;
  will-change: transform;
}

.line {
  position: absolute;
  background: rgba(255, 255, 255, 0.16);
  pointer-events: none;
}

.line-horizontal {
  top: 50%;
  left: -8%;
  width: 116%;
  height: 1px;
}

.line-vertical {
  top: 4%;
  left: 55%;
