  --accent-green: #4caf50;
  --accent-leaf: #f0eb66;
  --success: #66bb6a;
  --text: #ffffff;
  --text-light: rgba(255, 255, 255, 0.78);
  --text-lighter: rgba(255, 255, 255, 0.62);
  --text-on-dark: #ffffff;
  --bg: var(--logo-dark);
  --bg-light: #222329;
  --bg-dark: #111216;
  --bg-dark-light: #222329;
